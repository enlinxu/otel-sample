FROM eclipse-temurin:17-jre
WORKDIR /app

ARG OTEL_AGENT_VERSION=2.26.1
ARG OTEL_AGENT_URL=https://repo1.maven.org/maven2/io/opentelemetry/javaagent/opentelemetry-javaagent/${OTEL_AGENT_VERSION}/opentelemetry-javaagent-${OTEL_AGENT_VERSION}.jar
ARG OTEL_AGENT_SHA=""

RUN apt-get update && apt-get install -y wget \
    && wget -O /app/opentelemetry-javaagent.jar ${OTEL_AGENT_URL} \
    && if [ -n "${OTEL_AGENT_SHA}" ]; then \
         echo "${OTEL_AGENT_SHA}  /app/opentelemetry-javaagent.jar" | sha256sum -c -; \
       fi \
    && chmod 644 /app/opentelemetry-javaagent.jar \
    && rm -rf /var/lib/apt/lists/*

COPY src/inventory-service/build/libs/inventory-service-1.0.0.jar app.jar

ENTRYPOINT ["java", "-javaagent:/app/opentelemetry-javaagent.jar", "-jar", "app.jar"]