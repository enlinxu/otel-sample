#!/bin/sh
# Gradle wrapper script

DIRNAME=$(dirname "$0")
cd "$DIRNAME"

# Determine Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD="java"
fi

exec "$JAVA_CMD" \
    -classpath "$DIRNAME/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"